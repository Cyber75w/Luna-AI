#!/usr/bin/env sh
set -eu
PROJECT_DIR=$(CDPATH= cd "$(dirname "$0")" && pwd)
PYTHON="$PROJECT_DIR/.venv/bin/python"
if [ ! -x "$PYTHON" ]; then
  printf '%s\n' "Luna's environment is missing. Set it up from the project folder with:" "  python3 -m venv .venv" "  ./.venv/bin/python -m pip install -e ." >&2
  exit 1
fi
cd "$PROJECT_DIR"
exec "$PYTHON" -m luna "$@"
